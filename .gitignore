# Build artefacts – everything under build/ is regenerable
build/

# LaTeX intermediates (when compiling outside build/)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# Python
.venv/
__pycache__/
*.pyc

# Credentials – never commit
.env

# Hardware run logs (keep the directory, not its contents)
reproduction/logs/*
!reproduction/logs/.gitkeep

# Nix / direnv
.direnv/
result
result-*
