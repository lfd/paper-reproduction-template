# Copy this file to .env (same directory) and fill in your credentials.
# .env is gitignored and must NEVER be committed.
#
# Used by reproduction/hardware/run_hardware.py:
#   --backend ibm    IBM Quantum via qiskit-ibm-runtime
#   --backend mqss   IQM machines at LRZ via the MQSS adapter
#   --backend local  no credentials needed

# IBM Quantum – token from https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=your_token_here
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_URL=

# MQSS (Munich Quantum Software Stack, e.g. the IQM Euro-Q-Exa machine).
MQSS_TOKEN=your_mqss_token_here
